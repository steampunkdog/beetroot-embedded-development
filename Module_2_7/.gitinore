# =========================================================================
# STM32CubeIDE / Eclipse Build Artifacts
# =========================================================================
Debug/
Release/
[Dd]ebug/
[Rr]elease/

# Ignore common intermediate and binary files
*.o
*.su
*.d
*.elf
*.hex
*.bin
*.map

# =========================================================================
# IDE Settings and Personal Preferences
# =========================================================================
.metadata/
.settings/

# Hardware debugger launch/session configs (often tied to specific ST-Link serial numbers)
*.launch
*.jlink

# Log files generated by the compiler or IDE
*.log